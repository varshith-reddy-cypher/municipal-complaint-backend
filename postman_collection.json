{
  "info": {
    "name": "Municipal Complaint Prioritization System API",
    "description": "Postman Collection for College Project Demonstration conforming to PDF Specification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Submit Complaint (POST /api/complaints)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Live Electric Wire Dangling on Footpath\",\n  \"description\": \"Storm damaged overhead power line, sparking dangerously near bus stop.\",\n  \"citizenId\": 1,\n  \"departmentId\": 3,\n  \"zoneId\": \"ZONE-NORTH\",\n  \"latitude\": 12.9750,\n  \"longitude\": 77.5990,\n  \"photoUrl\": \"https://example.com/sparking-wire.jpg\",\n  \"severityLevel\": 5,\n  \"affectedCount\": 30,\n  \"isCriticalHazard\": true\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/complaints",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "complaints"]
        }
      }
    },
    {
      "name": "2. Fetch Priority Queue (GET /api/complaints/priority)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/complaints/priority?onlyActive=true",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "complaints", "priority"],
          "query": [
            {
              "key": "onlyActive",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "3. Assign to Officer (PUT /api/complaints/{id}/assign)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"officerId\": 4,\n  \"notes\": \"Urgent inspection dispatched to electrical emergency response unit\"\n}"
        },
        "url": {
